# Copy to .env and fill in only what your area needs. .env is gitignored: never commit it,
# never paste keys into issues, commits or chat. Providers are Proposed (see docs/decisions/).

# --- Cortex API -----------------------------------------------------------------------
# Where clients (dashboard, capture, call agent) reach the API. Mock: http://127.0.0.1:4010
CORTEX_API_URL=http://127.0.0.1:4010

# --- Data store (ADR 0002, Proposed) --------------------------------------------------
# MongoDB Atlas: mongodb+srv://<user>:<password>@cluster.example.mongodb.net/cortex
# Postgres + pgvector: postgres://<user>:<password>@localhost:5432/cortex
DATABASE_URL=
# Where snapshots are stored (local folder or bucket URL)
SNAPSHOT_STORE=./data/snapshots
VIDEO_STORE=./data/videos

# --- Models (ADR 0004, Proposed: pick one provider each) ------------------------------
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
LLM_API_KEY=
# Vision captions; leave empty to reuse the LLM provider
VISION_MODEL=
STT_PROVIDER=
STT_API_KEY=
TTS_PROVIDER=
TTS_API_KEY=

# --- LiveKit (our own project; all three must belong to the same project) -------------
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Chert (FaceTime bridge) ----------------------------------------------------------
# Project API key (starts with ftk_). Only ever sent to app.trychert.com.
CHERT_API_KEY=
CHERT_PROJECT_ID=
# Text actions (ACT-9): the shared line's UUID (GET https://app.trychert.com/api/v1/lines).
# MESSAGE_DRY_RUN=true saves the text as a draft instead of sending. Only verified phones get texts.
CHERT_LINE_ID=
MESSAGE_DRY_RUN=true
# Name the call agent registers with; must match `chert dev --agent NAME`
AGENT_NAME=cortex-call-agent

# --- Google sign-in for the dashboard (apps/dashboard/auth.ts, Auth.js) ---------------
# All three set = sign-in on and /app requires it. Any empty = sign-in off and /app stays open.
# AUTH_SECRET: `npx auth secret`. Google client: console.cloud.google.com > APIs & Services >
# Credentials > OAuth client ID (Web). Redirect URIs: http://localhost:3000/api/auth/callback/google
# and https://<your domain>/api/auth/callback/google
# Sign-in also asks for Calendar events, Tasks and Drive (drive.file) for ACT-5 to ACT-7; enable the
# Google Calendar, Tasks and Drive APIs on the same Google Cloud project. The backend reads
# AUTH_GOOGLE_ID and AUTH_GOOGLE_SECRET too, to refresh GOOGLE_REFRESH_TOKEN (optional: lets voice
# and call confirmations reach Google without the dashboard forwarding the user's token).
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
GOOGLE_REFRESH_TOKEN=

# --- Follow-up email action (T0-7) ----------------------------------------------------
# EMAIL_DRY_RUN=true saves a draft instead of sending (safe default for rehearsal)
EMAIL_DRY_RUN=true
EMAIL_PROVIDER=
EMAIL_FROM=
EMAIL_API_KEY=
