# Backend-only settings. The backend reads the repo-root .env first, then this folder's .env (wins).
# Shared names (DATABASE_URL, LLM_*, EMAIL_*) live in the root .env.example. Never commit .env.

# Data store (ADR 0002): MongoDB Atlas = memory ("what"), Tiger Data = time-series ("when").
# DATABASE_URL in the root .env is the MongoDB Atlas URL: mongodb+srv://<user>:<password>@<cluster>/cortex
MONGODB_DB=cortex
MONGO_VECTOR_INDEX=moment_vectors
# true = in-memory MongoDB (offline dev and tests; no Atlas Vector Search, local cosine instead)
USE_MONGOMOCK=false
# Tiger Data (Postgres + TimescaleDB). Leave empty to run on MongoDB alone.
TIGER_DATABASE_URL=
# Example: postgres://tsdbadmin:<password>@<service>.<project>.tsdb.cloud.timescale.com:<port>/tsdb?sslmode=require

# Models (ADR 0004). Root .env: LLM_PROVIDER=gemini, LLM_MODEL=gemini-3.5-flash-lite, LLM_API_KEY=<key>
EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768
# true = rule-based fake model, no API calls (tests, offline rehearsal). Also used when LLM_API_KEY is empty.
LLM_MOCK=false

# Server
PORT=8000
# Base URL used to build snapshot_url for new snapshots
PUBLIC_URL=http://localhost:8000
CORS_ORIGINS=*
CORTEX_TZ=America/Chicago

# Follow-up email (D-7). Root .env: EMAIL_DRY_RUN=true (default), EMAIL_PROVIDER=smtp|resend, EMAIL_FROM, EMAIL_API_KEY
# Send is delayed until the undo window closes, so undo really cancels it.
ACTION_UNDO_SECONDS=30
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
