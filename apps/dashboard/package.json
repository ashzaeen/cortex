{
  "name": "cortex-dashboard",
  "private": true,
  "description": "Cortex companion web app (iPhone first). See ADR 0005.",
  "scripts": {
    "dev": "next dev --port 3000 --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --port 3000",
    "mock": "node mock/server.mjs",
    "test": "node mock/test.mjs && node mock/skills-test.mjs && node mock/profile-test.mjs && node scripts/build-tokens.mjs --check",
    "mock:demo": "node mock/server.mjs --profile demo",
    "typecheck": "tsc --noEmit",
    "types": "openapi-typescript ../../contracts/openapi.yaml -o lib/api-types.ts",
    "tokens": "node scripts/build-tokens.mjs"
  },
  "dependencies": {
    "lucide-react": "1.61.0",
    "motion": "14.6.0",
    "next": "16.4.3",
    "next-auth": "5.0.0-beta.32",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
