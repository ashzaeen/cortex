{
  "name": "cortex-dashboard",
  "private": true,
  "description": "Cortex companion web app (iPhone first). See ADR 0005.",
  "scripts": {
    "dev": "next dev --port 3000 --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --port 3000",
    "mock": "node mock/server.mjs",
    "test": "node mock/test.mjs",
    "typecheck": "tsc --noEmit",
    "types": "openapi-typescript ../../contracts/openapi.yaml -o lib/api-types.ts"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
